---
extends: default
ignore: |
  .collections/
  inventory/group_vars/all/secrets.sops.yml
rules:
  line-length:
    max: 120
  truthy:
    allowed-values: ["true", "false"]
  comments-indentation: false
  comments:
    min-spaces-from-content: 1
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
